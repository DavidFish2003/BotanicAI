# OpenAI API Key for structured pharmacological extraction (GPT-4o-mini)
# If left empty, BotanicAI falls back to its built-in rule-based NLP extraction engine.
OPENAI_API_KEY=

# Optional NCBI API Key for higher PubMed request rate limits (10 req/s vs 3 req/s)
NCBI_API_KEY=

# Backend server settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
